<Window x:Class="WorldCupWPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings" Height="340" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="gray">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Label Content="Window Title:" FontWeight="Bold" Foreground="White"/>
            <TextBox x:Name="txtTitle" Height="28" VerticalContentAlignment="Center" Background="#222222" Foreground="White" BorderBrush="#444444"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Label Content="Select Championship:" FontWeight="Bold" Foreground="White"/>
            <ComboBox x:Name="cbGender" Height="25">
                <ComboBoxItem Content="Male (World Cup 2018)" Tag="male" IsSelected="True"/>
                <ComboBoxItem Content="Female (World Cup 2019)" Tag="female"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <Label Content="Display Mode:" FontWeight="Bold" Foreground="White"/>
            <ComboBox x:Name="cbResolution" Height="25">
                <ComboBoxItem Content="Fullscreen" Tag="fullscreen"/>
                <ComboBoxItem Content="720 x 540" Tag="720x540"/>
                <ComboBoxItem Content="1024 x 720" Tag="1024x720" IsSelected="True"/>
                <ComboBoxItem Content="1200 x 800" Tag="1200x800"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click"/>
            <Button x:Name="btnConfirm" Content="Confirm" Width="80" Height="30" IsDefault="True" Click="BtnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>