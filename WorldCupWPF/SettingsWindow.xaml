<Window x:Class="WorldCupWPF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorldCupWPF"
        mc:Ignorable="d"
        Title="Initial Settings" Height="280" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <Label Content="Select Championship:" FontWeight="Bold"/>
            <ComboBox x:Name="cbGender" Height="25">
                <ComboBoxItem Content="Male (World Cup 2018)" Tag="male" IsSelected="True"/>
                <ComboBoxItem Content="Female (World Cup 2019)" Tag="female"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Label Content="Display Mode:" FontWeight="Bold"/>
            <ComboBox x:Name="cbResolution" Height="25">
                <ComboBoxItem Content="Fullscreen" Tag="fullscreen"/>
                <ComboBoxItem Content="1280 x 720" Tag="1280x720" IsSelected="True"/>
                <ComboBoxItem Content="1920 x 1080" Tag="1920x1080"/>
                <ComboBoxItem Content="1024 x 768" Tag="1024x768"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel" Content="Cancel" Width="80" Height="30" Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click"/>
            <Button x:Name="btnConfirm" Content="Confirm" Width="80" Height="30" IsDefault="True" Click="BtnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
