<UserControl x:Class="WorldCupWPF.PlayerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WorldCupWPF"
             mc:Ignorable="d" 
             Width="85" Height="105">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid Width="60" Height="60" HorizontalAlignment="Center">
                <Border x:Name="borderPlayerImage" CornerRadius="30" BorderThickness="2" BorderBrush="#3B82F6" Background="#E2E8F0">
                    <Image x:Name="imgPlayer" Stretch="UniformToFill">
                        <Image.Clip>
                            <EllipseGeometry Center="29,29" RadiusX="29" RadiusY="29"/>
                        </Image.Clip>
                    </Image>
                </Border>

                <Border Background="#1E3A8A" CornerRadius="10" Padding="4,2" 
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" MinWidth="20">
                    <TextBlock x:Name="txtShirtNumber" Text="{Binding ShirtNumber}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
            </Grid>

            <TextBlock x:Name="txtPlayerName" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" 
                       Foreground="White" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0">
                <TextBlock.Background>
                    <SolidColorBrush Color="Black" Opacity="0.4"/>
                </TextBlock.Background>

                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="315" Color="Black" Opacity="0.8"/>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>