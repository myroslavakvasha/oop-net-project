<Window x:Class="WorldCupWPF.TeamInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="National Team Information" Height="420" Width="400"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        AllowsTransparency="True" WindowStyle="None" BorderThickness="1" BorderBrush="#CBD5E1">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.RenderTransform>
        <TranslateTransform Y="0"/>
    </Window.RenderTransform>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="txtCountryName" Text="Country Name" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtFifaCode" Text="Code: AAA" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            <Separator Margin="0,12,0,0" Background="#E2E8F0"/>
        </StackPanel>

        <Grid Grid.Row="1" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="8" Padding="8" Margin="4" BorderThickness="1" BorderBrush="#E2E8F0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Games" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtGames" Text="0" FontSize="16" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Background="#F0FDF4" CornerRadius="8" Padding="8" Margin="4" BorderThickness="1" BorderBrush="#DCFCE7">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Goals Scored" FontSize="11" Foreground="#16A34A" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtGoalsScored" Text="0" FontSize="16" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Background="#ECFDF5" CornerRadius="8" Padding="8" Margin="4" BorderThickness="1" BorderBrush="#D1FAE5">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Wins" FontSize="11" Foreground="#059669" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtWins" Text="0" FontSize="16" FontWeight="Bold" Foreground="#065F46" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Background="#FFF5F5" CornerRadius="8" Padding="8" Margin="4" BorderThickness="1" BorderBrush="#FEE2E2">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Goals Conceded" FontSize="11" Foreground="#E11D48" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtGoalsConceded" Text="0" FontSize="16" FontWeight="Bold" Foreground="#9F1239" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Background="#FEF2F2" CornerRadius="8" Padding="8" Margin="4" BorderThickness="1" BorderBrush="#FEE2E2">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Losses" FontSize="11" Foreground="#DC2626" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtLosses" Text="0" FontSize="16" FontWeight="Bold" Foreground="#991B1B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Background="#EFF6FF" CornerRadius="8" Padding="8" Margin="4" BorderThickness="1" BorderBrush="#DBEAFE">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Goal Difference" FontSize="11" Foreground="#2563EB" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtGoalDiff" Text="0" FontSize="26" FontWeight="Black" Foreground="#1E40AF" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="8" Margin="4" BorderThickness="1" BorderBrush="#E2E8F0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Draws" FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtDraws" Text="0" FontSize="16" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Button Grid.Row="2" Content="Close" Width="100" Height="32" IsCancel="True"
                Background="#475569" Foreground="White" FontWeight="SemiBold" Click="BtnClose_Click" Margin="0,16,0,0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>