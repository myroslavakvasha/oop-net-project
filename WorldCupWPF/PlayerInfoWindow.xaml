<Window x:Class="WorldCupWPF.PlayerInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WorldCupWPF"
        mc:Ignorable="d"
        Title="Player Profile" Height="400" Width="350"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC"
        AllowsTransparency="True" WindowStyle="None" BorderThickness="1" BorderBrush="#CBD5E1">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.85" To="1.0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.85" To="1.0" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.RenderTransform>
        <ScaleTransform CenterX="175" CenterY="200"/>
    </Window.RenderTransform>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Ellipse Fill="#E2E8F0"/>
                <Image x:Name="imgPlayerPhoto" Stretch="UniformToFill">
                    <Image.Clip>
                        <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50"/>
                    </Image.Clip>
                </Image>
                <Border x:Name="brdCaptainBadge" Visibility="Collapsed" Background="#F59E0B" CornerRadius="4" Padding="6,2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-6">
                    <TextBlock Text="CAPTAIN" FontSize="9" FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>

            <TextBlock x:Name="txtPlayerName" Text="Player Name" FontSize="20" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" TextAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                <TextBlock x:Name="txtPosition" Text="Position" FontSize="13" Foreground="#64748B"/>
                <TextBlock Text=" • " FontSize="13" Foreground="#94A3B8"/>
                <TextBlock Text="#" FontSize="13" Foreground="#2563EB" FontWeight="Bold"/>
                <TextBlock x:Name="txtShirtNumber" Text="0" FontSize="13" Foreground="#2563EB" FontWeight="Bold"/>
            </StackPanel>
            <Separator Margin="0,12,0,0" Background="#E2E8F0"/>
        </StackPanel>

        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F0FDF4" CornerRadius="8" Padding="12" Margin="6" BorderThickness="1" BorderBrush="#DCFCE7">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Match Goals" FontSize="11" Foreground="#16A34A" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtMatchGoals" Text="0" FontSize="28" FontWeight="Bold" Foreground="#166534" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FEFCE8" CornerRadius="8" Padding="12" Margin="6" BorderThickness="1" BorderBrush="#FEF08A">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Yellow Cards" FontSize="11" Foreground="#CA8A04" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtYellowCards" Text="0" FontSize="28" FontWeight="Bold" Foreground="#854D0E" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Button Grid.Row="2" Content="Close" Width="100" Height="32" IsCancel="True"
                Background="#475569" Foreground="White" FontWeight="SemiBold" Click="BtnClose_Click" Margin="0,16,0,0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
